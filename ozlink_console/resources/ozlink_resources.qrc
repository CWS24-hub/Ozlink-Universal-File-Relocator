    <file alias="ozlink_app_icon_32.png">branding/ozlink_app_icon_32.png</file>
    <file alias="ozlink_app_icon_48.png">branding/ozlink_app_icon_48.png</file>
    <file alias="ozlink_app_icon_64.png">branding/ozlink_app_icon_64.png</file>
    <file alias="ozlink_app_icon_128.png">branding/ozlink_app_icon_128.png</file>
